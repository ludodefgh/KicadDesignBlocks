(version 1)

# Regles personnalisees -- voir Docs/kicad-headless-lessons.md
#
# U4 (BH1750) : regle d'exception 0,09 mm supprimee le 2026-11-10 -- pastilles
# refaites (0,3 mm, 0,2 mm entre elles).
# Classe Power (2026-10-21, revue independante #30) : la largeur des rails
# n'etait imposee qu'a freerouting via le DSN ; KiCad ne la verifiait pas et
# 18,5 mm de +5V a 0,12 mm passaient le DRC. Minimum 0,4 mm partout, SAUF dans
# le courtyard des boitiers a pas fin, ou le retrecissement a l'entree du pad
# est legitime (QFN 0,5 mm, SOT-23-6, USB-C).
(rule "Power : largeur mini hors pads fins"
	(layer outer)
	(condition "A.NetClass == 'Power' && !A.intersectsCourtyard('U11') && !A.intersectsCourtyard('J3')")
	(constraint track_width (min 0.4mm)))

# Regles d'assemblage reprises de PlantSensor/myco-mini-host-pcb (2026-11-10).
# Assemblage a la main au hotplate : marge au bord de carte et entre composants.
# Exclus de la regle de bord : composants places au bord par necessite
# (J1, J3, J5, J6, J8, U1 : connecteurs, et U1 dont l'antenne doit etre au bord de carte).
# TP* exclus (2026-11-12) : pastilles de test, rien a souder au hotplate ; la fente
# thermique de U2 compte comme un bord.
(rule "Courtyard au bord de carte (dessus, marge hotplate)"
	(layer "F.CrtYd")
	(constraint physical_clearance (min 1mm))
	(condition "B.Layer == 'Edge.Cuts' && A.Reference != 'J1' && A.Reference != 'J3' && A.Reference != 'J5' && A.Reference != 'J6' && A.Reference != 'J8' && A.Reference != 'U1' && A.Reference != 'TP*'"))

(rule "Courtyard au bord de carte (dessous, marge hotplate)"
	(layer "B.CrtYd")
	(constraint physical_clearance (min 1mm))
	(condition "B.Layer == 'Edge.Cuts' && A.Reference != 'J1' && A.Reference != 'J3' && A.Reference != 'J5' && A.Reference != 'J6' && A.Reference != 'J8' && A.Reference != 'U1' && A.Reference != 'TP*'"))

# Bloc U11 (TPS563201) : paires internes exemptees -- TI SLVSD90B 7.4.1 veut les
# condensateurs "as close to the device as possible" ; le serrage est voulu.
# Les ecarts entre le bloc et le reste de la carte restent controles.
(rule "Courtyard a courtyard (assemblage a la main)"
	(constraint courtyard_clearance (min 0.5mm))
	(condition "!((A.Reference == 'U11' || A.Reference == 'L1' || A.Reference == 'C4' || A.Reference == 'C5' || A.Reference == 'C6' || A.Reference == 'C7' || A.Reference == 'C8' || A.Reference == 'C9' || A.Reference == 'R5' || A.Reference == 'R6') && (B.Reference == 'U11' || B.Reference == 'L1' || B.Reference == 'C4' || B.Reference == 'C5' || B.Reference == 'C6' || B.Reference == 'C7' || B.Reference == 'C8' || B.Reference == 'C9' || B.Reference == 'R5' || B.Reference == 'R6'))"))

# U1 au bord de carte (2026-11-12) : bord haut droit, module remonte contre le bord
# (antenne au bord, recommandation Raytac). Ses pastilles GND 42/43, les vias GND des
# coins et leurs petites zones F.Cu sont a 0,25-0,35 mm du bord. Exception a 0,2 mm
# (valeur du breakout NRF54L) limitee a la zone de regle "U1_bord" (x 118,5-133,5,
# y 98,9-104) ; le reste de la carte, plans internes compris, garde 0,5 mm.
# Les grandes zones (plans) qui traversent U1_bord ne sont pas concernees : seules
# les zones entierement contenues dans U1_bord le sont.
(rule "U1 : cuivre au bord 0,2 mm (zone U1_bord)"
	(constraint edge_clearance (min 0.2mm))
	(condition "A.intersectsArea('U1_bord') && (A.Type != 'Zone' || A.enclosedByArea('U1_bord'))"))
